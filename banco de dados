CREATE DATABASE retro_games;
USE retro_games;

CREATE TABLE jogos (
    id INT AUTO_INCREMENT PRIMARY KEY,
    nome VARCHAR(100) NOT NULL,
    autor VARCHAR(100) NOT NULL,
    genero VARCHAR(50) NOT NULL,
    imagem VARCHAR(500) NOT NULL,
    preco DECIMAL(10,2) NOT NULL
);

